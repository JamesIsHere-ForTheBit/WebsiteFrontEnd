RHEL Commands to limit Python functionality
echo "playerone ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active *, /usr/bin/systemctl restart *" | sudo tee /etc/sudoers.d/playerone

New-NetFirewallRule -DisplayName "Allow SMTP" -Direction Inbound -Protocol TCP -LocalPort 25 -Action Allow
New-NetFirewallRule -DisplayName "Allow IMAP" -Direction Inbound -Protocol TCP -LocalPort 143 -Action Allow

sudo firewall-cmd --permanent --add-rich-rule='rule protocol value="icmp" drop'
sudo firewall-cmd --reload

New-NetFirewallRule -DisplayName "Block ICMP Inbound" -Direction Inbound -Protocol ICMPv4 -Action Block

curl -sO https://packages.wazuh.com/4.7/wazuh-install.sh
sudo bash wazuh-install.sh -a

